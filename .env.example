# For Vercel deployment (Server-side, recommended & secure):
GEMINI_API_KEY=your_gemini_api_key_here

# Optional custom PIN for the private /team & team.* portal (defaults to 1380 if unset):
TEAM_PIN=1380

# Optional: For local Vite dev testing only (never commit .env):
VITE_GEMINI_API_KEY=your_gemini_api_key_here
